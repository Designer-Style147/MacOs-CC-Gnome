<?xml version="1.0" encoding="UTF-8"?>
<!--
  Persistence for the "Edit Controls" picker and the arrange mode.

  adopted-toggles: the titles of GNOME Shell / third-party Quick Settings
  toggles (QuickToggle or QuickMenuToggle) that the user added to the control
  center, e.g. "Caffeine" or "GSConnect".

  custom-layout: where those controls sit and how big they are, one JSON object
  per control: {"t": title, "x": column, "y": row, "w": column span, "h": row
  span}. The grid has four columns; entries that no longer belong to an adopted
  control are pruned on the next write.

  Titles are the only stable handle the Shell exposes on those actors, so a
  locale change may drop an entry; the picker simply shows it unchecked again.
-->
<schemalist gettext-domain="macos-control-center">

  <schema id="org.gnome.shell.extensions.macos-control-center"
          path="/org/gnome/shell/extensions/macos-control-center/">

    <key name="adopted-toggles" type="as">
      <default>[]</default>
      <summary>Adopted Quick Settings toggles</summary>
      <description>
        Titles of the Quick Settings toggles that were added to the control
        center through the "Edit Controls" picker.
      </description>
    </key>

    <key name="custom-layout" type="as">
      <default>[]</default>
      <summary>Position and size of custom controls</summary>
      <description>
        One JSON object per custom control, giving its column, row, column span
        and row span in the four-column custom grid.
      </description>
    </key>

  </schema>

</schemalist>
